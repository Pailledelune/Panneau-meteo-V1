#!/usr/bin/python2.7
# -*- coding: utf-8 -*-
#
# Service meteo : retrouve la position de la ville choisie, interroge
# Open-Meteo toutes les 15 minutes et ecrit meteo.json, lu par node.lua.
# Compatible Python 2.7 (info-beamer) et 3.

import datetime
import json
import os
import time
import traceback

import requests

URL_METEO = "https://api.open-meteo.com/v1/forecast"
URL_VILLE = "https://geocoding-api.open-meteo.com/v1/search"
PERIODE = 15 * 60          # secondes entre deux mises a jour
PERIODE_ERREUR = 2 * 60    # nouvel essai apres une erreur
PAUSE = 20                 # frequence de lecture des reglages

GEL = 0.0                  # degres : risque de verglas en dessous


def lire_config():
    try:
        with open("config.json") as f:
            return json.load(f)
    except Exception:
        return {}


def chercher_ville(nom, pays):
    params = {"name": nom, "count": 1, "language": "fr", "format": "json"}
    if pays:
        params["countryCode"] = pays.strip().upper()
    r = requests.get(URL_VILLE, timeout=20, params=params)
    r.raise_for_status()
    resultats = r.json().get("results") or []
    if not resultats:
        return None
    return resultats[0]


def condition(code, jour):
    """Code meteo WMO -> (animation de node.lua, libelle)"""
    if code == 0:
        return ("soleil" if jour else "lune"), u"Ciel dégagé"
    if code == 1:
        return ("eclaircies" if jour else "eclaircies_nuit"), u"Peu nuageux"
    if code == 2:
        return ("eclaircies" if jour else "eclaircies_nuit"), u"Partiellement nuageux"
    if code == 3:
        return "nuageux", u"Couvert"
    if code == 45:
        return "brouillard", u"Brouillard"
    if code == 48:
        return "brouillard", u"Brouillard givrant"
    if code in (56, 57):
        return "verglas", u"Bruine verglaçante"
    if code in (66, 67):
        return "verglas", u"Pluie verglaçante"
    if 51 <= code <= 55:
        return "pluie", u"Bruine"
    if 61 <= code <= 65:
        return "pluie", u"Pluie"
    if 80 <= code <= 82:
        return "pluie", u"Averses"
    if 71 <= code <= 77:
        return "neige", u"Neige"
    if code in (85, 86):
        return "neige", u"Averses de neige"
    if code in (95, 96, 99):
        return "orage", u"Orage"
    return "nuageux", u"Couvert"


def risque_verglas(temperature, pluies):
    """Estimation : gel apres des precipitations dans les dernieres heures"""
    return temperature <= GEL and any((p or 0) > 0 for p in pluies)


def heure(texte):
    return texte[11:16]            # "2026-10-31T07:36" -> "07:36"


def prevision(jours, i):
    d = datetime.datetime.strptime(jours["time"][i], "%Y-%m-%d")
    return {
        "jour": (d.weekday() + 1) % 7,      # 0 = dimanche
        "quantieme": d.day,
        "anim": condition(jours["weather_code"][i], True)[0],
        "max": jours["temperature_2m_max"][i],
        "min": jours["temperature_2m_min"][i],
        "pluie": jours["precipitation_probability_max"][i],
    }


def interroger(ville):
    r = requests.get(URL_METEO, timeout=20, params={
        "latitude": ville["latitude"],
        "longitude": ville["longitude"],
        "current": "temperature_2m,apparent_temperature,relative_humidity_2m,"
                   "pressure_msl,wind_speed_10m,wind_direction_10m,"
                   "weather_code,is_day",
        "hourly": "precipitation",
        "past_hours": 6,
        "forecast_hours": 1,
        "daily": "weather_code,temperature_2m_max,temperature_2m_min,"
                 "precipitation_probability_max,sunrise,sunset",
        "forecast_days": 6,
        "timezone": "auto",
        "wind_speed_unit": "kmh",
    })
    r.raise_for_status()
    donnees = r.json()
    actuel = donnees["current"]
    jours = donnees["daily"]

    anim, libelle = condition(actuel["weather_code"], actuel.get("is_day", 1) == 1)
    pluies = donnees.get("hourly", {}).get("precipitation") or []
    if anim != "verglas" and risque_verglas(actuel["temperature_2m"], pluies):
        anim, libelle = "verglas", u"Risque de verglas"

    return {
        "ville": ville["name"],
        "decalage": donnees.get("utc_offset_seconds"),
        "temperature": actuel["temperature_2m"],
        "ressenti": actuel["apparent_temperature"],
        "humidite": actuel["relative_humidity_2m"],
        "pression": actuel["pressure_msl"],
        "vent": actuel["wind_speed_10m"],
        "direction": actuel["wind_direction_10m"],
        "anim": anim,
        "libelle": libelle,
        "lever": heure(jours["sunrise"][0]),
        "coucher": heure(jours["sunset"][0]),
        "previsions": [prevision(jours, i) for i in range(1, 6)],
        "maj": int(time.time()),
    }


def ecrire(meteo):
    # Ecriture dans un fichier temporaire puis renommage : node.lua ne lit
    # jamais un fichier a moitie ecrit
    with open("meteo.json.tmp", "w") as f:
        json.dump(meteo, f)
    os.rename("meteo.json.tmp", "meteo.json")


def main():
    choix_vu = None        # (ville, pays) deja recherches
    position = None
    prochaine = 0
    while True:
        config = lire_config()
        choix = (config.get("ville") or u"Sarrebourg", config.get("pays", u"FR"))
        if choix != choix_vu or time.time() >= prochaine:
            try:
                if choix != choix_vu:
                    position = chercher_ville(*choix)
                    choix_vu = choix
                if position is None:
                    ecrire({"ville": choix[0], "erreur": u"Ville introuvable"})
                else:
                    meteo = interroger(position)
                    ecrire(meteo)
                    print("meteo: %s" % json.dumps(meteo))
                prochaine = time.time() + PERIODE
            except Exception:
                traceback.print_exc()
                prochaine = time.time() + PERIODE_ERREUR
        time.sleep(PAUSE)


if __name__ == "__main__":
    main()
